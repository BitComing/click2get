{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Click2Get",
  "version": "0.1.0",
  "identifier": "com.click2get.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Click2Get",
        "width": 1020,
        "height": 720,
        "minWidth": 620,
        "minHeight": 420,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#F6F6F8",
        "additionalBrowserArgs": "--disable-gpu --disable-background-networking --disable-component-update --disable-sync --js-flags=--max-old-space-size=192"
      }
    ],
    "security": {
      "csp": "default-src 'none'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "shortDescription": "剪贴板捕获式笔记工具",
    "longDescription": "开着监控，任何地方复制的文字/图片都会自动追加到当前笔记。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}